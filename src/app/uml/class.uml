@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam class {
    BackgroundColor white
    ArrowColor black
    BorderColor black
}

class User {
  - id: Long
  - email: String
  - password: String
  - role: String
}

class Product {
  - id: Long
  - title: String
  - description: String
  - price: Double
  - imageUrl: String
  - stockQuantity: Integer
  - categoryId: Long
}

class UserInteraction {
  - id: Long
  - interactionType: String
  - timestamp: Date
  - userId: Long
  - productId: Long
}

User "1" -- "0..*" UserInteraction : πραγματοποιεί >
Product "1" -- "0..*" UserInteraction : αφορά >

@enduml