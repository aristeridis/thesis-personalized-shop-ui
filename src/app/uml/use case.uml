@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Πελάτης" as customer
actor "Διαχειριστής" as admin
actor "Σύστημα" as system << Δευτερεύων >>

rectangle "Crab E-Shop" {
  
  usecase "Αναζήτηση Προϊόντος" as search
  usecase "Προσθήκη στο Καλάθι" as add_cart
  usecase "Ολοκλήρωση Αγοράς" as checkout
  usecase "Λήψη Προτάσεων" as recommendations
  
  usecase "Προσθήκη Νέου Προϊόντος" as add_product
  
  usecase "Καταγραφή Αλληλεπίδρασης" as record_interaction
}

customer --> search
customer --> add_cart
customer --> checkout
customer --> recommendations

admin --> add_product

system --> record_interaction

add_cart .> record_interaction : <<include>>
checkout .> record_interaction : <<include>>

@enduml